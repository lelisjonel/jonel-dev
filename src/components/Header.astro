---
// src/components/Header.astro
// The navbar. `isActive` highlights the link for the page you're on.
// On small screens the links collapse into a hamburger menu.
import { site } from '../data/site';
import { getPosts } from '../lib/blog';

// "Blog" only appears once there is at least one post to read.
const hasPosts = (await getPosts()).length > 0;

const links = [
  { label: 'Work', href: '/work' },
  ...(hasPosts ? [{ label: 'Blog', href: '/blog' }] : []),
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/#contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/#contact' && path.startsWith(href);
---

<header class="nav">
  <div class="container nav_inner">
    <a class="nav_logo" href="/" aria-label="Home">
      {site.name.toLowerCase()}<span class="text-accent">.dev</span>
    </a>
    <button class="nav_toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
      <span class="nav_toggle-bar"></span>
      <span class="nav_toggle-bar"></span>
      <span class="nav_toggle-bar"></span>
    </button>
    <nav id="nav-menu" class="nav_menu" aria-label="Main">
      <ul class="nav_list">
        {links.map((link) => (
          <li>
            <a
              class:list={['nav_link', { 'is-active': isActive(link.href) }]}
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a class="button is-primary nav_button" href={site.bookingUrl} target="_blank" rel="noopener">Book a call</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Open/close the mobile menu. Closes on link click and on Escape.
  const toggle = document.querySelector<HTMLButtonElement>('.nav_toggle');
  const header = document.querySelector('.nav');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header?.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('.nav_menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // Close if the screen grows past the mobile breakpoint while open.
  matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
