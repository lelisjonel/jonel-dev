---
// src/components/PostCard.astro
// One blog post in a list. Webflow comparison: an item in a Collection List.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, readingTime } from '../lib/blog';
import { site } from '../data/site';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, draft, cover, coverAlt } = post.data;
---

<a class:list={['post-card', { 'has-cover': cover }]} href={`/blog/${post.id}`}>
  {cover && (
    <Image class="post-card_cover" src={cover} alt={coverAlt ?? ''} width={640} />
  )}
  <div class="post-card_body">
    <div class="post-card_meta">
      <span class="post-card_author">
        <img class="post-card_avatar" src={site.photo} alt="" width="24" height="24" />
        {site.fullName}
      </span>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span>{readingTime(post)}</span>
      {draft && <span class="post-card_draft">Draft</span>}
    </div>
    <h3 class="post-card_title">{title} <span class="project-card_arrow">→</span></h3>
    <p class="text-muted">{description}</p>
  </div>
</a>
