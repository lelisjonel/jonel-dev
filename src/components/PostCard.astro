---
// src/components/PostCard.astro
// One blog post in a list. Webflow comparison: an item in a Collection List.
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, draft } = post.data;
---

<a class="post-card" href={`/blog/${post.id}`}>
  <div class="post-card_meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <span>{readingTime(post)}</span>
    {draft && <span class="post-card_draft">Draft</span>}
  </div>
  <h3 class="post-card_title">{title} <span class="project-card_arrow">→</span></h3>
  <p class="text-muted">{description}</p>
</a>
