---
// src/components/PostCard.astro
// One blog post card. Webflow comparison: an item in a Collection List.
// Posts without a cover get a generated thumbnail (gradient + first tag).
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, readingTime } from '../lib/blog';
import photo from '../assets/jonel.png';
import { site } from '../data/site';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, draft, cover, coverAlt, tags } = post.data;
---

<a class="post-card" href={`/blog/${post.id}`}>
  <div class="post-card_thumb">
    {cover ? (
      <Image class="post-card_cover" src={cover} alt={coverAlt ?? ''} width={720} />
    ) : (
      <span class="post-card_placeholder" aria-hidden="true">{tags.length ? tags.join(' · ') : 'Blog'}</span>
    )}
  </div>
  <div class="post-card_body">
    <div class="post-card_meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span>{readingTime(post)}</span>
      {draft && <span class="post-card_draft">Draft</span>}
    </div>
    <h3 class="post-card_title">{title}</h3>
    <p class="post-card_description text-muted">{description}</p>
    <div class="post-card_footer">
      <span class="post-card_author">
        <Image class="post-card_avatar" src={photo} alt="" width={28} height={28} densities={[1, 2]} />
        {site.fullName}
      </span>
      <span class="post-card_arrow" aria-hidden="true">→</span>
    </div>
  </div>
</a>
