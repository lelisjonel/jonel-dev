---
// src/layouts/BaseLayout.astro
// -----------------------------------------------------------------------------
// The wrapper every page uses: <html>, <head>, header, footer.
// Webflow comparison: a page template with the Navbar and Footer already placed.
// -----------------------------------------------------------------------------
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
// Vercel Web Analytics: visitor counts, no cookies, tiny script.
import Analytics from '@vercel/analytics/astro';
import ScrollReveal from '../components/ScrollReveal.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article'; // og:type, "article" for blog posts
  noindex?: boolean;            // true = ask Google not to index this page
  image?: string;               // share image URL (og:image), e.g. a blog cover
}

// Pages without their own image (home, about, blog list) use the site-wide share card.
const { title, description = site.tagline, type = 'website', noindex = false, image = '/og-image.png' } = Astro.props;

// Home page shows just "Jonel — Web Designer & Developer".
const fullTitle = title ? `${title} | ${site.fullName}` : `${site.fullName} | ${site.role}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PNG icons: Google search results and older browsers can't use the SVG. -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0b0b0f" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:alt" content={`${site.fullName}, ${site.role}`} />
    <meta property="og:site_name" content="jonel.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="main-wrapper">
      <slot />
    </main>
    <Footer />
    <ScrollReveal />
    <Analytics />
  </body>
</html>
