---
// src/pages/404.astro  ->  shown for any URL that doesn't exist
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1 class="heading-xl hero_title" style="margin-top: 1rem">This page doesn't exist.</h1>
      <p class="text-large text-muted hero_text">The link may be broken, or the page was moved.</p>
      <a class="button is-primary" href="/">Back to home</a>
    </div>
  </section>
</BaseLayout>
