---
// src/pages/contact.astro  ->  URL: /contact
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.fullName}, ${site.role}, about a new website, ongoing Webflow maintenance, or a job or contract role.`}
>
  <section class="case_header">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Contact</span>
        <h1 class="heading-xl case_title">Let's work together</h1>
        <p class="text-large text-muted">
          Have a Figma file that needs building, a Webflow site that needs care, or a role to fill?
          Send me a message and I'll get back to you.
        </p>
        <ul class="contact_details">
          <li><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.socials.map((s) => (
            <li><span>{s.label}</span><a href={s.href} target="_blank" rel="noopener">{s.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>
          ))}
          <li><span>Hours</span>{site.availability}</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
