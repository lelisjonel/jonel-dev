---
// src/pages/index.astro  ->  URL: /
// -----------------------------------------------------------------------------
// The home page: hero, featured work, services, and a contact call-to-action.
// -----------------------------------------------------------------------------
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { getFeaturedProjects } from '../lib/work';
import { getPosts } from '../lib/blog';

const featured = await getFeaturedProjects();
const latestPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout description="Jonel Lelis is a Webflow (Client-First) and Astro developer in the Philippines who turns Figma designs into fast, pixel-perfect, SEO-ready websites.">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero_intro">
        <img class="hero_avatar" src={site.photo} alt={site.fullName} width="56" height="56" />
        {site.available && (
          <p class="hero_status"><span class="hero_dot"></span> Available for new projects</p>
        )}
      </div>
      <h1 class="heading-xl hero_title">
        Hi, I'm {site.fullName}. I turn Figma designs into fast, <span class="text-accent text-nowrap hero_highlight">pixel-perfect</span> Webflow &amp; Astro sites.
      </h1>
      <p class="text-large text-muted hero_text">
        {site.yearsExperience}+ years building Client-First Webflow sites and lightning-fast Astro sites, from {site.location}.
      </p>
      <p class="hero_availability">{site.availability}</p>
      <div class="button-group hero_actions">
        <a class="button is-primary" href="/contact">Get in touch</a>
        <a class="button" href="/work">View my work</a>
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container">
      <div class="section_header">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="heading-l">Recent projects</h2>
        </div>
        <a class="link-arrow" href="/work">All projects →</a>
      </div>
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section_header">
        <div>
          <span class="eyebrow">What I do</span>
          <h2 class="heading-l">Services</h2>
        </div>
      </div>
      <div class="service-grid">
        {site.services.map((service, i) => (
          <div class="service-item">
            <span class="service-item_number">0{i + 1}</span>
            <h3 class="heading-m">{service.title}</h3>
            <p class="text-muted">{service.text}</p>
          </div>
        ))}
      </div>
      <ul class="tag-list" aria-label="Tools I use">
        {site.tools.map((tool) => <li class="tag">{tool}</li>)}
      </ul>
    </div>
  </section>

  <!-- Latest posts (hidden until there is at least one post) -->
  {latestPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section_header">
          <div>
            <span class="eyebrow">Blog</span>
            <h2 class="heading-l">Latest posts</h2>
          </div>
          <a class="link-arrow" href="/blog">All posts →</a>
        </div>
        <div class="post-list">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Contact</span>
        <h2 class="heading-l contact_title">Have a Figma file that needs building? Let's talk.</h2>
        <p class="text-large text-muted">Send me a message about a project, ongoing maintenance or a role, and I'll get back to you.</p>
        <p class="hero_availability">{site.availability}</p>
        <div class="button-group">
          <a class="button" href={`mailto:${site.email}`}>{site.email}</a>
          {site.socials.map((s) => (
            <a class="button" href={s.href} target="_blank" rel="noopener">{s.label}</a>
          ))}
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
